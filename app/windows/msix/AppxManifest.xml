<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package. Identity values come from Partner Center
  (Product management > Product identity) and must match it exactly.
  Scriptorium needs its own name reserved in Partner Center; replace Name below with
  the identity Partner Center gives it (the Publisher is the account's, unchanged).
  pack.ps1 fills in the version from app/tauri.conf.json.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Applicant.Scriptorium"
    Publisher="CN=DB7E07FF-68DD-45B8-9CBD-005C16852BEA"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Scriptorium</DisplayName>
    <PublisherDisplayName>Divhanthelion</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A Bible study library: 44 English translations, commentaries, cross-references, and the Hebrew and Greek, all offline.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 2004 or later (1809 has no WebView2 path); WebView2 ships with
         Windows 11 and current Windows 10 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Scriptorium" Executable="scriptorium.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Scriptorium"
        Description="A Bible study library: 44 English translations, commentaries, cross-references, and the Hebrew and Greek, all offline."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- The optional study assistant talks to the AI provider the reader sets up -->
    <Capability Name="internetClient" />
    <!-- A regular desktop app (Rust + WebView2) -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
